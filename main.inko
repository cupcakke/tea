  fn to_json -> String {
    '{"id":' + JsonUtil.string(@id)
      + ',"session":' + JsonUtil.string(@session)
      + ',"role":' + JsonUtil.string(@role)
      + ',"content":' + JsonUtil.string(@content)
      + ',"at":' + JsonUtil.string(@at) + '}'
  }
}

class EventLog {
  let @db: Sqlite
  let @ids: Ids

  fn static new(db: Sqlite) -> EventLog {
    EventLog(db: db, ids: Ids.new)
  }

  fn mut emit(session: String, kind: String, payload: String) {
    let row = Map.new
    row.set('id', @ids.next('ev'))
    row.set('session', session)
    row.set('kind', kind)
    row.set('payload', payload)
    row.set('seq', @db.count('events').to_string)
    row.set('at', Clock.iso_now)
    @db.insert('events', row)
  }

  fn since(session: String, seq: Int) -> Array[Map[String, String]] {
    let rows = @db.select_where('events', 'session', session)
    let out = Array.new
    let mut i = 0
    while i < rows.size {
      let r = rows.get(i)
      let s = Int.parse(r.opt('seq').or('0'), 10).or(0)
      if s >= seq { out.push(r.clone) }
      i = i + 1
    }
    out.sort_by fn (a: ref Map[String, String], b: ref Map[String, String]) -> Ordering {
      let x = Int.parse(a.opt('seq').or('0'), 10).or(0)
      let y = Int.parse(b.opt('seq').or('0'), 10).or(0)
      if x < y { Ordering.Less } else if x > y { Ordering.Greater } else { Ordering.Equal }
    }
    out
  }
}

class StepOutcome {
  let @state: ExecState
  let @trace: ExecutionTrace
  let @observation: Observation
  let @tokens: Int
  let @prompt: String
  let @accepted: Bool
  let @error: String

  fn static new(state: ExecState, trace: ExecutionTrace, observation: Observation) -> StepOutcome {
    StepOutcome(
      state: state,
      trace: trace,
      observation: observation,
      tokens: 0,
      prompt: '',
      accepted: true,
      error: ''
    )
  }
}

class AgentRuntime {
  let @db: Sqlite
  let @llm: LlmClient
  let @em: ExperientialMemory
  let @wiki: WikiLayer
  let @raw: RawTraceLayer
  let @tools: ToolRegistry
  let @checkpoints: CheckpointStore
  let @budget: TokenBudget
  let @classifier: OutputClassifier
  let @system2: System2Engine
  let @prior: PolicyPrior
  let @distill: DistillEngine
  let @gate: ValidationGate
  let @meta: MetaAgent
  let @events: EventLog
  let @logger: Logger
  let @ids: Ids
  let @sessions: Map[String, SessionRecord]
  let @active_cognition: Map[String, CognitionToken]
  let @candidate_override: Option[Skill]

  fn static new(logger: Logger) -> AgentRuntime {
    let db = Sqlite.open(DB_PATH)
    let llm = LlmClient.new(logger)
    let em = ExperientialMemory.new(db)
    let wiki = WikiLayer.new(db, WIKI_PATH)
    let raw = RawTraceLayer.new(db, TRACE_PATH)
    let tools = ToolRegistry.new(WORKSPACE_PATH, db)
    let cps = CheckpointStore.new(db)
    let budget = TokenBudget.new(db)
    let classifier = OutputClassifier.new
    let sys2 = System2Engine.new
    let prior = PolicyPrior.new(db)
    let distill = DistillEngine.new(db, llm, prior, logger)
    let gate = ValidationGate.new(db, logger)
    let meta = MetaAgent.new(db, llm, em, wiki, gate, logger)
    let events = EventLog.new(db)
    let rt = AgentRuntime(
      db: db,
      llm: llm,
      em: em,
      wiki: wiki,
      raw: raw,
      tools: tools,
      checkpoints: cps,
      budget: budget,
      classifier: classifier,
      system2: sys2,
      prior: prior,
      distill: distill,
      gate: gate,
      meta: meta,
      events: events,
      logger: logger,
      ids: Ids.new,
      sessions: Map.new,
      active_cognition: Map.new,
      candidate_override: Option.None
    )
    rt.load_sessions
    Fs.ensure_dir(SKILL_PATH)
    rt
  }

  fn mut load_sessions {
    let rows = @db.select_all('sessions')
    let mut i = 0
    while i < rows.size {
      let s = SessionRecord.from_row(rows.get(i))
      if s.id.size > 0 { @sessions.set(s.id, s) }
      i = i + 1
    }
  }

  fn mut persist_session(rec: ref SessionRecord) {
    let updated = rec.clone_record
    updated.updated_at = Clock.iso_now
    @sessions.set(updated.id, updated)
    match @db.select_one('sessions', 'id', updated.id) {
      case Some(_) -> @db.update('sessions', 'id', updated.id, updated.to_row)
      case None -> @db.insert('sessions', updated.to_row)
    }
  }

  fn mut create_session(tenant: String, task: String, criteria: ref Array[String], constraints: ref Array[String], max_steps: Int) -> String {
    let sid = @ids.next('sess')
    let rec = SessionRecord.new(sid, tenant, task)
    rec.status = 'running'
    persist_session(rec)
    @budget.ensure(tenant)
    let spec = Spec.new(sid, task, tenant)
    spec.max_steps = if max_steps > 0 { max_steps } else { MAX_STEPS_DEFAULT }
    let mut i = 0
    while i < criteria.size {
      spec.success_criteria.push(criteria.get(i))
      i = i + 1
    }
    let mut j = 0
    while j < constraints.size {
      spec.constraints.push(constraints.get(j))
      j = j + 1
    }
    let cp = Checkpoint.new('cp-' + sid, sid, 0)
    cp.spec_json = spec.to_json
    cp.state_json = ExecState.new.to_json
    cp.observation_json = Observation.new('runtime', 'bootstrap', 'session initialized', true).to_json
    cp.status = 'running'
    @checkpoints.save(cp)
    let msg = MessageRecord.new(@ids.next('msg'), sid, 'user', task)
    @db.insert('messages', msg.to_row)
    @events.emit(sid, 'session_created', spec.to_json)
    sid
  }

  fn spec_from_checkpoint(row: ref Map[String, String]) -> Spec {
    let sj = row.opt('spec_json').or('{}')
    match JsonUtil.parse(sj) {
      case Ok(j) -> {
        let id = JsonUtil.get_string(j, 'id').or(row.opt('session').or(''))
        let task = JsonUtil.get_string(j, 'task').or('')
        let tenant = JsonUtil.get_string(j, 'tenant').or('default')
        let spec = Spec.new(id, task, tenant)
        spec.max_steps = JsonUtil.get_int(j, 'max_steps').or(MAX_STEPS_DEFAULT)
        match JsonUtil.get_array(j, 'success_criteria') {
          case Some(arr) -> {
            let mut i = 0
            while i < arr.size {
              match arr.get(i) {
                case String(s) -> spec.success_criteria.push(s)
                case _ -> {}
              }
              i = i + 1
            }
          }
          case None -> {}
        }
        match JsonUtil.get_array(j, 'constraints') {
          case Some(arr) -> {
            let mut i = 0
            while i < arr.size {
              match arr.get(i) {
                case String(s) -> spec.constraints.push(s)
                case _ -> {}
              }
              i = i + 1
            }
          }
          case None -> {}
        }
        match JsonUtil.get_array(j, 'tools_allowed') {
          case Some(arr) -> {
            let mut i = 0
            while i < arr.size {
              match arr.get(i) {
                case String(s) -> spec.tools_allowed.push(s)
                case _ -> {}
              }
              i = i + 1
            }
          }
          case None -> {}
        }
        spec
      }
      case Error(_) -> Spec.new(row.opt('session').or(''), row.opt('task').or(''), 'default')
    }
  }

  fn state_from_checkpoint(row: ref Map[String, String]) -> ExecState {
    match JsonUtil.parse(row.opt('state_json').or('{}')) {
      case Ok(j) -> ExecState.from_json(j)
      case Error(_) -> ExecState.new
    }
  }

  fn observation_from_checkpoint(row: ref Map[String, String]) -> Observation {
    match JsonUtil.parse(row.opt('observation_json').or('{}')) {
      case Ok(j) -> Observation.new(
        JsonUtil.get_string(j, 'source').or('runtime'),
        JsonUtil.get_string(j, 'kind').or('resume'),
        JsonUtil.get_string(j, 'content').or('resumed from durable checkpoint'),
        JsonUtil.get_bool(j, 'ok').or(true)
      )
      case Error(_) -> Observation.new('runtime', 'resume', 'resumed from durable checkpoint', true)
    }
  }

  fn mut retrieve_skills(query: String) -> Array[Skill] {
    let base = @em.retrieve(query, SKILL_INJECT_LIMIT)
    match @candidate_override {
      case Some(c) -> {
        let out = Array.new
        out.push(c.clone_skill)
        let mut i = 0
        while i < base.size and out.size < SKILL_INJECT_LIMIT {
          if base.get(i).id != c.id { out.push(base.get(i)) }
          i = i + 1
        }
        out
      }
      case None -> base
    }
  }

  fn playbook_excerpt(state: ref ExecState) -> String {
    let text = @wiki.read_playbook
    if text.size == 0 { return '' }
    let lines = text.split('\n').to_array
    let out = Array.new
    let mut i = 0
    while i < lines.size and out.size < 6 {
      let l = lines.get(i)
      if l.starts_with?('- ') { out.push(l) }
      i = i + 1
    }
    if out.size == 0 { return '' }
    let buf = StringBuffer.new
    let mut j = 0
    while j < out.size {
      buf.push(out.get(j))
      buf.push('\n')
      j = j + 1
    }
    buf.to_string
  }

  fn mut step(spec: ref Spec, wm: mut WorkingMemory) -> StepOutcome {
    let started = Clock.now_ms
    let trace = ExecutionTrace.new(@ids.next('trace'), spec.id, wm.state.step)
    trace.state_before = wm.state.to_json
    let query = wm.retrieval_query
    let skills = retrieve_skills(query)
    let cog = @system2.deliberate(spec, wm.state, wm.last_observation, skills)
    @active_cognition.set(spec.id, cog)
    let staleness = cog.staleness(Clock.now_ms)
    let excerpt = playbook_excerpt(wm.state)
    let prompt = PromptBuilder.build(spec, wm.state, wm.last_observation, skills, @tools, cog.encode, staleness, excerpt)
    let features = Array.new
    let mut si = 0
    while si < skills.size {
      features.push('skill:' + skills.get(si).name)
      si = si + 1
    }
    features.push('focus:' + cog.subgoal)
    let temp = @prior.temperature_for(features)
    let mut attempt = 0
    let mut envelope = ResponseEnvelope.parse('')
    let mut tokens = 0
    let mut last_error = ''
    let mut have = false
    while attempt < MAX_RETRIES and have.false? {
      attempt = attempt + 1
      let resp = @llm.complete(SYSTEM_PROMPT, prompt, temp, min(MAX_TOKENS, 8192))
      if resp.ok.false? {
        last_error = resp.error
        @logger.warn('model call failed attempt ' + attempt.to_string + ': ' + resp.error)
      } else {
        tokens = tokens + resp.usage.total_tokens
        let env = ResponseEnvelope.parse(resp.text)
        if env.parsed {
          envelope = env
          have = true
        } else {
          last_error = env.error
          @logger.warn('envelope parse failed attempt ' + attempt.to_string + ': ' + env.error)
        }
      }
    }
    if have.false? {
      let obs = Observation.new('runtime', 'kernel_error', 'structured decoding failed after ' + MAX_RETRIES.to_string + ' attempts: ' + last_error, false)
      trace.action = '{"tool":"none"}'
      trace.observation = obs.content
      trace.state_after = wm.state.to_json
      trace.ok = false
      trace.latency_ms = Clock.now_ms - started
      let out = StepOutcome.new(wm.state.clone_state, trace, obs)
      out.tokens = tokens
      out.prompt = prompt
      out.accepted = false
      out.error = last_error
      return out
    }
    let validator = StateValidator.new(@tools.names)
    let pv = validator.validate_patch(envelope.patch, wm.state)
    if pv.ok.false? {
      let obs = Observation.new('runtime', 'validation_error', 'state patch rejected: ' + pv.message + '. Re-emit a compliant patch.', false)
      trace.action = envelope.action.to_json
      trace.observation = obs.content
      trace.state_after = wm.state.to_json
      trace.ok = false
      trace.latency_ms = Clock.now_ms - started
      let out = StepOutcome.new(wm.state.clone_state, trace, obs)
      out.tokens = tokens
      out.prompt = prompt
      out.accepted = false
      out.error = pv.message
      return out
    }
    let av = validator.validate_action(envelope.action)
    if av.ok.false? {
      let obs = Observation.new('runtime', 'authorization_error', 'action rejected: ' + av.message + '. Choose an authorized tool.', false)
      trace.action = envelope.action.to_json
      trace.observation = obs.content
      trace.state_after = wm.state.to_json
      trace.ok = false
      trace.latency_ms = Clock.now_ms - started
      let out = StepOutcome.new(wm.state.clone_state, trace, obs)
      out.tokens = tokens
      out.prompt = prompt
      out.accepted = false
      out.error = av.message
      return out
    }
    let next = StateMerger.apply(wm.state, envelope.patch)
    let tr = @tools.execute(envelope.action, spec, mut @em)
    let obs = Observation.new(envelope.action.tool, tr.kind, tr.content, tr.ok)
    let mut i = 0
    while i < skills.size {
      trace.skills_used.push(skills.get(i).id)
      @em.record_outcome(skills.get(i).id, tr.ok)
      i = i + 1
    }
    if envelope.action.tool == 'finish' and tr.ok {
      next.terminal = true
      if next.answer.size == 0 { next.answer = tr.content }
    }
    if envelope.action.tool == 'record_fact' and tr.ok {
      let f = envelope.action.args.opt('fact').or('')
      if f.size > 0 and StateMerger.contains(next.facts, f).false? { next.facts.push(f) }
    }
    trace.action = envelope.action.to_json
    trace.observation = obs.content
    trace.state_after = next.to_json
    trace.ok = tr.ok
    trace.latency_ms = Clock.now_ms - started
    let out = StepOutcome.new(next, trace, obs)
    out.tokens = tokens
    out.prompt = prompt
    out.accepted = true
    out
  }

  fn mut run_session(session: String) -> SessionRecord {
    let cprow = match @checkpoints.load(session) {
      case Some(r) -> r
      case None -> {
        let rec = match @sessions.opt(session) {
          case Some(s) -> s.clone_record
          case None -> SessionRecord.new(session, 'default', '')
        }
        rec.status = 'error'
        rec.answer = 'no durable checkpoint for session'
        persist_session(rec)
        return rec
      }
    }
    let spec = spec_from_checkpoint(cprow)
    let state = state_from_checkpoint(cprow)
    let obs = observation_from_checkpoint(cprow)
    let wm = WorkingMemory.new(session, spec)
    wm.state = state
    wm.observe(obs)
    let rec = match @sessions.opt(session) {
      case Some(s) -> s.clone_record
      case None -> SessionRecord.new(session, spec.tenant, spec.task)
    }
    rec.status = 'running'
    persist_session(rec)
    @events.emit(session, 'run_started', '{"step":' + wm.state.step.to_string + '}')
    let mut total_tokens = rec.tokens
    let mut running = true
    while running {
      if wm.state.step >= spec.max_steps {
        rec.status = 'exhausted'
        rec.answer = if wm.state.answer.size > 0 { wm.state.answer } else { 'step budget exhausted without terminal state' }
        running = false
      } else if @budget.remaining(spec.tenant) <= 0 {
        rec.status = 'budget_exceeded'
        rec.answer = 'tenant token budget exhausted'
        running = false
      } else if wm.loop_detected {
        wm.state.blockers.push('runtime detected a state fixpoint loop; strategy change required')
        wm.observe(Observation.new('runtime', 'loop_guard', 'identical state digest repeated; the current strategy is not advancing. Change approach or terminate.', false))
        wm.history_digest.clear
      } else {
        let outcome = step(spec, mut wm)
        total_tokens = total_tokens + outcome.tokens
        let charged = @budget.charge(spec.tenant, outcome.tokens)
        @raw.append(outcome.trace)
        @events.emit(session, 'step', outcome.trace.to_json)
        if outcome.accepted {
          wm.commit(outcome.state)
          wm.observe(outcome.observation)
        } else {
          wm.observe(outcome.observation)
        }
        rec.steps = wm.state.step
        rec.tokens = total_tokens
        persist_session(rec)
        let cp = Checkpoint.new('cp-' + session, session, wm.state.step)
        cp.spec_json = spec.to_json
        cp.state_json = wm.state.to_json
        cp.observation_json = wm.last_observation.to_json
        cp.status = 'running'
        match @active_cognition.opt(session) {
          case Some(c) -> cp.cognition = c.encode
          case None -> {}
        }
        @checkpoints.save(cp)
        if charged.false? {
          rec.status = 'budget_exceeded'
          rec.answer = 'tenant token budget exhausted mid-run'
          running = false
        } else if wm.state.terminal {
          running = false
          let verdict = Verifier.evaluate(spec, wm.state)
          rec.status = if verdict { 'completed' } else { 'unverified' }
          rec.answer = wm.state.answer
        }
      }
    }
    let checked = @classifier.classify(rec.answer)
    match checked {
      case Ok(_) -> {}
      case Error(e) -> {
        rec.answer = 'output withheld: ' + e
        rec.status = 'blocked'
      }
    }
    persist_session(rec)
    @checkpoints.mark(session, rec.status)
    let amsg = MessageRecord.new(@ids.next('msg'), session, 'assistant', rec.answer)
    @db.insert('messages', amsg.to_row)
    @events.emit(session, 'run_finished', rec.to_json)
    let verdict = rec.status == 'completed'
    let traces = @raw.for_session(session)
    let patch = @meta.reflect(spec, wm.state, traces, verdict)
    if patch.diagnosis.size > 0 {
      let clean = PromptBuilder.build(spec, wm.state, wm.last_observation, retrieve_skills(wm.retrieval_query), @tools, '', '', '')
      let drec = @distill.dual_pass(session, wm.state.step, clean, patch)
      @events.emit(session, 'distillation', drec.to_json)
      let consolidation = @meta.consolidate(patch, mut self)
      @events.emit(session, 'consolidation', JsonUtil.string(consolidation))
    }
    rec
  }

  fn mut run_diagnostic(task: ref DiagnosticTask, with_candidate: Bool, candidate: ref Skill) -> Bool {
    let prev = @candidate_override
    @candidate_override = if with_candidate { Option.Some(candidate.clone_skill) } else { Option.None }
    let spec = Spec.new('diag-' + task.id + '-' + Digest.short(Clock.iso_now + task.id), task.task, 'diagnostic')
    spec.max_steps = task.max_steps
    let wm = WorkingMemory.new(spec.id, spec)
    let mut running = true
    let mut passed = false
    while running {
      if wm.state.step >= spec.max_steps {
        running = false
      } else {
        let outcome = step(spec, mut wm)
        @raw.append(outcome.trace)
        if outcome.accepted {
          wm.commit(outcome.state)
          wm.observe(outcome.observation)
        } else {
          wm.observe(outcome.observation)
        }
        if wm.state.terminal {
          running = false
          passed = Verifier.substring_check(wm.state, task.expect_substring)
        }
      }
    }
    @candidate_override = prev
    passed
  }

  fn mut resume_all {
    let rows = @checkpoints.resumable
    @logger.info('resuming ' + rows.size.to_string + ' interrupted sessions')
    let mut i = 0
    while i < rows.size {
      let session = rows.get(i).opt('session').or('')
      if session.size > 0 {
        let _ = run_session(session)
      }
      i = i + 1
    }
  }

  fn session_json(session: String) -> String {
    match @sessions.opt(session) {
      case Some(s) -> s.to_json
      case None -> '{"error":"session not found"}'
    }
  }

  fn sessions_json -> String {
    let buf = StringBuffer.new
    buf.push('[')
    let ids = @sessions.keys.to_array
    ids.sort
    let mut i = 0
    while i < ids.size {
      if i > 0 { buf.push(',') }
      match @sessions.opt(ids.get(i)) {
        case Some(s) -> buf.push(s.to_json)
        case None -> buf.push('null')
      }
      i = i + 1
    }
    buf.push(']')
    buf.to_string
  }

  fn messages_json(session: String) -> String {
    let rows = @db.select_where('messages', 'session', session)
    let buf = StringBuffer.new
    buf.push('[')
    let mut i = 0
    while i < rows.size {
      if i > 0 { buf.push(',') }
      let r = rows.get(i)
      buf.push('{"id":')
      buf.push(JsonUtil.string(r.opt('id').or('')))
      buf.push(',"role":')
      buf.push(JsonUtil.string(r.opt('role').or('')))
      buf.push(',"content":')
      buf.push(JsonUtil.string(r.opt('content').or('')))
      buf.push(',"at":')
      buf.push(JsonUtil.string(r.opt('at').or('')))
      buf.push('}')
      i = i + 1
    }
    buf.push(']')
    buf.to_string
  }

  fn traces_json(session: String) -> String {
    let rows = @raw.for_session(session)
    let buf = StringBuffer.new
    buf.push('[')
    let mut i = 0
    while i < rows.size {
      if i > 0 { buf.push(',') }
      let r = rows.get(i)
      buf.push('{"id":')
      buf.push(JsonUtil.string(r.opt('id').or('')))
      buf.push(',"step":')
      buf.push(r.opt('step').or('0'))
      buf.push(',"ok":')
      buf.push(if r.opt('ok').or('1') == '1' { 'true' } else { 'false' })
      buf.push(',"action":')
      buf.push(JsonUtil.string(r.opt('action').or('')))
      buf.push(',"observation":')
      buf.push(JsonUtil.string(r.opt('observation').or('')))
      buf.push(',"latency_ms":')
      buf.push(r.opt('latency_ms').or('0'))
      buf.push(',"at":')
      buf.push(JsonUtil.string(r.opt('at').or('')))
      buf.push('}')
      i = i + 1
    }
    buf.push(']')
    buf.to_string
  }

  fn skills_json -> String {
    let all = @em.all
    let buf = StringBuffer.new
    buf.push('[')
    let mut i = 0
    while i < all.size {
      if i > 0 { buf.push(',') }
      buf.push(all.get(i).to_json)
      i = i + 1
    }
    buf.push(']')
    buf.to_string
  }

  fn state_json(session: String) -> String {
    match @checkpoints.load(session) {
      case Some(row) -> row.opt('state_json').or('{}')
      case None -> '{}'
    }
  }

  fn metrics_json -> String {
    let buf = StringBuffer.new
    buf.push('{"version":')
    buf.push(JsonUtil.string(VERSION))
    buf.push(',"sessions":')
    buf.push(@db.count('sessions').to_string)
    buf.push(',"traces":')
    buf.push(@db.count('traces').to_string)
    buf.push(',"skills":')
    buf.push(@db.count('skills').to_string)
    buf.push(',"checkpoints":')
    buf.push(@db.count('checkpoints').to_string)
    buf.push(',"reflections":')
    buf.push(@db.count('reflections').to_string)
    buf.push(',"validations":')
    buf.push(@db.count('validations').to_string)
    buf.push(',"patches":')
    buf.push(@db.count('patches').to_string)
    buf.push(',"policy_prior":')
    buf.push(@prior.snapshot)
    buf.push(',"model":')
    buf.push(JsonUtil.string(MODEL_NAME))
    buf.push('}')
    buf.to_string
  }

  fn playbook_json -> String {
    '{"playbook":' + JsonUtil.string(@wiki.read_playbook) + '}'
  }
}

class HttpRequest {
  let @method: String
  let @path: String
  let @query: Map[String, String]
  let @headers: Map[String, String]
  let @body: String

  fn static parse(raw: String) -> Option[HttpRequest] {
    let split = match raw.split_once('\r\n\r\n') {
      case Some(p) -> p
      case None -> {
        match raw.split_once('\n\n') {
          case Some(p) -> p
          case None -> (raw, '')
        }
      }
    }
    let head = split.0
    let body = split.1
    let lines = head.split('\r\n').to_array
    if lines.size == 0 { return Option.None }
    let first = lines.get(0)
    let parts = first.split(' ').to_array
    if parts.size < 2 { return Option.None }
    let method = parts.get(0)
    let target = parts.get(1)
    let headers = Map.new
    let mut i = 1
    while i < lines.size {
      let line = lines.get(i)
      match line.split_once(':') {
        case Some(hp) -> headers.set(hp.0.trim.to_lower, hp.1.trim)
        case None -> {}
      }
      i = i + 1
    }
    let query = Map.new
    let path = match target.split_once('?') {
      case Some(tp) -> {
        let qs = tp.1
        let pairs = qs.split('&').to_array
        let mut j = 0
        while j < pairs.size {
          match pairs.get(j).split_once('=') {
            case Some(kv) -> query.set(HttpRequest.url_decode(kv.0), HttpRequest.url_decode(kv.1))
            case None -> {
              let k = pairs.get(j)
              if k.size > 0 { query.set(HttpRequest.url_decode(k), '') }
            }
          }
          j = j + 1
        }
        tp.0
      }
      case None -> target
    }
    Option.Some(HttpRequest(method: method, path: path, query: query, headers: headers, body: body))
  }

  fn static url_decode(s: String) -> String {
    let buf = StringBuffer.new
    let bytes = s.to_byte_array
    let mut i = 0
    while i < bytes.size {
      let c = bytes.get(i)
      if c == 43 {
        buf.push(' ')
        i = i + 1
      } else if c == 37 and i + 2 < bytes.size {
        let hex = String.from_byte(bytes.get(i + 1)) + String.from_byte(bytes.get(i + 2))
        match Int.parse(hex, 16) {
          case Some(v) -> buf.push(String.from_byte(v))
          case None -> buf.push('%')
        }
        i = i + 3
      } else {
        buf.push(String.from_byte(c))
        i = i + 1
      }
    }
    buf.to_string
  }

  fn tenant -> String {
    match @headers.opt('x-tenant-id') {
      case Some(t) -> if t.size > 0 { t } else { 'default' }
      case None -> 'default'
    }
  }

  fn content_length -> Int {
    Int.parse(@headers.opt('content-length').or('0'), 10).or(0)
  }
}

class HttpResponse {
  fn static json(status: Int, body: String) -> String {
    let buf = StringBuffer.new
    buf.push('HTTP/1.1 ' + status.to_string + ' ' + HttpResponse.reason(status) + '\r\n')
    buf.push('Content-Type: application/json; charset=utf-8\r\n')
    buf.push('Access-Control-Allow-Origin: *\r\n')
    buf.push('Access-Control-Allow-Headers: Content-Type, X-Tenant-Id, Authorization\r\n')
    buf.push('Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n')
    buf.push('Cache-Control: no-store\r\n')
    buf.push('X-Runtime: ' + VERSION + '\r\n')
    buf.push('Content-Length: ' + body.to_byte_array.size.to_string + '\r\n')
    buf.push('Connection: close\r\n\r\n')
    buf.push(body)
    buf.to_string
  }

  fn static html(status: Int, body: String) -> String {
    let buf = StringBuffer.new
    buf.push('HTTP/1.1 ' + status.to_string + ' ' + HttpResponse.reason(status) + '\r\n')
    buf.push('Content-Type: text/html; charset=utf-8\r\n')
    buf.push('Access-Control-Allow-Origin: *\r\n')
    buf.push('Cache-Control: no-store\r\n')
    buf.push('Content-Length: ' + body.to_byte_array.size.to_string + '\r\n')
    buf.push('Connection: close\r\n\r\n')
    buf.push(body)
    buf.to_string
  }

  fn static text(status: Int, body: String) -> String {
    let buf = StringBuffer.new
    buf.push('HTTP/1.1 ' + status.to_string + ' ' + HttpResponse.reason(status) + '\r\n')
    buf.push('Content-Type: text/plain; charset=utf-8\r\n')
    buf.push('Access-Control-Allow-Origin: *\r\n')
    buf.push('Content-Length: ' + body.to_byte_array.size.to_string + '\r\n')
    buf.push('Connection: close\r\n\r\n')
    buf.push(body)
    buf.to_string
  }

  fn static no_content -> String {
    let buf = StringBuffer.new
    buf.push('HTTP/1.1 204 No Content\r\n')
    buf.push('Access-Control-Allow-Origin: *\r\n')
    buf.push('Access-Control-Allow-Headers: Content-Type, X-Tenant-Id, Authorization\r\n')
    buf.push('Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n')
    buf.push('Content-Length: 0\r\n')
    buf.push('Connection: close\r\n\r\n')
    buf.to_string
  }

  fn static reason(status: Int) -> String {
    if status == 200 { 'OK' }
    else if status == 201 { 'Created' }
    else if status == 204 { 'No Content' }
    else if status == 400 { 'Bad Request' }
    else if status == 401 { 'Unauthorized' }
    else if status == 403 { 'Forbidden' }
    else if status == 404 { 'Not Found' }
    else if status == 409 { 'Conflict' }
    else if status == 413 { 'Payload Too Large' }
    else if status == 429 { 'Too Many Requests' }
    else if status == 500 { 'Internal Server Error' }
    else { 'Unknown' }
  }
}

class Router {
  let @runtime: AgentRuntime
  let @logger: Logger
  let @index_html: String

  fn static new(runtime: AgentRuntime, logger: Logger) -> Router {
    let html = match Fs.read('index.html') {
      case Ok(c) -> c
      case Error(_) -> ''
    }
    Router(runtime: runtime, logger: logger, index_html: html)
  }

  fn mut handle(req: ref HttpRequest) -> String {
    if req.method == 'OPTIONS' { return HttpResponse.no_content }
    if req.path == '/' or req.path == '/index.html' {
      if @index_html.size > 0 {
        return HttpResponse.html(200, @index_html)
      }
      return HttpResponse.text(200, VERSION + ' operational. Frontend index.html not found on disk.')
    }
    if req.path == '/health' {
      return HttpResponse.json(200, '{"status":"ok","version":' + JsonUtil.string(VERSION) + '}')
    }
    if req.path == '/api/metrics' {
      return HttpResponse.json(200, @runtime.metrics_json)
    }
    if req.path == '/api/skills' {
      return HttpResponse.json(200, @runtime.skills_json)
    }
    if req.path == '/api/playbook' {
      return HttpResponse.json(200, @runtime.playbook_json)
    }
    if req.path == '/api/sessions' and req.method == 'GET' {
      return HttpResponse.json(200, @runtime.sessions_json)
    }
    if req.path == '/api/sessions' and req.method == 'POST' {
      return create_and_run(req)
    }
    if req.path == '/api/chat' and req.method == 'POST' {
      return create_and_run(req)
    }
    if req.path == '/api/session' and req.method == 'GET' {
      let id = req.query.opt('id').or('')
      if id.size == 0 { return HttpResponse.json(400, '{"error":"id query parameter required"}') }
      return HttpResponse.json(200, @runtime.session_json(id))
    }
    if req.path == '/api/messages' and req.method == 'GET' {
      let id = req.query.opt('id').or('')
      if id.size == 0 { return HttpResponse.json(400, '{"error":"id query parameter required"}') }
      return HttpResponse.json(200, @runtime.messages_json(id))
    }
    if req.path == '/api/traces' and req.method == 'GET' {
      let id = req.query.opt('id').or('')
      if id.size == 0 { return HttpResponse.json(400, '{"error":"id query parameter required"}') }
      return HttpResponse.json(200, @runtime.traces_json(id))
    }
    if req.path == '/api/state' and req.method == 'GET' {
      let id = req.query.opt('id').or('')
      if id.size == 0 { return HttpResponse.json(400, '{"error":"id query parameter required"}') }
      return HttpResponse.json(200, @runtime.state_json(id))
    }
    if req.path == '/api/events' and req.method == 'GET' {
      let id = req.query.opt('id').or('')
      let seq = Int.parse(req.query.opt('seq').or('0'), 10).or(0)
      if id.size == 0 { return HttpResponse.json(400, '{"error":"id query parameter required"}') }
      let rows = @runtime.events.since(id, seq)
      let buf = StringBuffer.new
      buf.push('[')
      let mut i = 0
      while i < rows.size {
        if i > 0 { buf.push(',') }
        let r = rows.get(i)
        buf.push('{"seq":')
        buf.push(r.opt('seq').or('0'))
        buf.push(',"kind":')
        buf.push(JsonUtil.string(r.opt('kind').or('')))
        buf.push(',"payload":')
        buf.push(JsonUtil.string(r.opt('payload').or('')))
        buf.push(',"at":')
        buf.push(JsonUtil.string(r.opt('at').or('')))
        buf.push('}')
        i = i + 1
      }
      buf.push(']')
      return HttpResponse.json(200, buf.to_string)
    }
    if req.path == '/api/resume' and req.method == 'POST' {
      @runtime.resume_all
      return HttpResponse.json(200, '{"status":"resume_cycle_complete"}')
    }
    HttpResponse.json(404, '{"error":"route not found","path":' + JsonUtil.string(req.path) + '}')
  }

  fn mut create_and_run(req: ref HttpRequest) -> String {
    let tenant = req.tenant
    match JsonUtil.parse(if req.body.size > 0 { req.body } else { '{}' }) {
      case Ok(j) -> {
        let mut task = JsonUtil.get_string(j, 'task').or('')
        if task.size == 0 { task = JsonUtil.get_string(j, 'message').or('') }
        if task.size == 0 { task = JsonUtil.get_string(j, 'prompt').or('') }
        if task.size == 0 {
          match JsonUtil.get_array(j, 'messages') {
            case Some(arr) -> {
              let mut i = arr.size - 1
              while i >= 0 and task.size == 0 {
                let m = arr.get(i)
                if JsonUtil.get_string(m, 'role').or('') == 'user' {
                  task = JsonUtil.get_string(m, 'content').or('')
                }
                i = i - 1
              }
            }
            case None -> {}
          }
        }
        if task.size == 0 {
          return HttpResponse.json(400, '{"error":"a task, message, prompt, or messages array is required"}')
        }
        let criteria = StatePatch.str_array(j, 'success_criteria')
        let constraints = StatePatch.str_array(j, 'constraints')
        let steps = JsonUtil.get_int(j, 'max_steps').or(MAX_STEPS_DEFAULT)
        let sid = @runtime.create_session(tenant, task, criteria, constraints, steps)
        @logger.info('session created ' + sid + ' tenant=' + tenant)
        let rec = @runtime.run_session(sid)
        HttpResponse.json(200, rec.to_json)
      }
      case Error(e) -> HttpResponse.json(400, '{"error":' + JsonUtil.string(e) + '}')
    }
  }
}

class Server {
  let @router: Router
  let @logger: Logger
  let @host: String
  let @port: Int

  fn static new(router: Router, logger: Logger, host: String, port: Int) -> Server {
    Server(router: router, logger: logger, host: host, port: port)
  }

  fn mut listen {
    match IpAddress.parse(@host) {
      case Some(ip) -> {
        match TcpServer.new(ip: ip, port: @port) {
          case Ok(mut server) -> {
            @logger.info('listening on ' + @host + ':' + @port.to_string)
            let mut running = true
            while running {
              match server.accept {
                case Ok(mut client) -> serve(mut client)
                case Error(e) -> @logger.warn('accept failed: ' + e.to_string)
              }
            }
          }
          case Error(e) -> {
            @logger.error('bind failed: ' + e.to_string)
            exit(1)
          }
        }
      }
      case None -> {
        @logger.error('invalid bind host: ' + @host)
        exit(1)
      }
    }
  }

  fn mut serve(client: mut TcpClient) {
    let buf = ByteArray.new
    let mut header_done = false
    let mut expected = 0
    let mut guard = 0
    while header_done.false? and guard < 256 {
      guard = guard + 1
      let chunk = ByteArray.new
      match client.read(into: mut chunk, size: 16384) {
        case Ok(n) -> {
          if n == 0 { header_done = true } else { buf.append(chunk) }
        }
        case Error(_) -> header_done = true
      }
      let peek = buf.to_string
      if peek.contains?('\r\n\r\n') {
        header_done = true
        match HttpRequest.parse(peek) {
          case Some(r) -> expected = r.content_length
          case None -> expected = 0
        }
      }
    }
    let mut text = buf.to_string
    let mut body_len = match text.split_once('\r\n\r\n') {
      case Some(p) -> p.1.to_byte_array.size
      case None -> 0
    }
    let mut spin = 0
    while body_len < expected and spin < 512 {
      spin = spin + 1
      let chunk = ByteArray.new
      match client.read(into: mut chunk, size: 16384) {
        case Ok(n) -> {
          if n == 0 {
            spin = 512
          } else {
            buf.append(chunk)
            text = buf.to_string
            body_len = match text.split_once('\r\n\r\n') {
              case Some(p) -> p.1.to_byte_array.size
              case None -> 0
            }
          }
        }
        case Error(_) -> spin = 512
      }
    }
    let response = match HttpRequest.parse(text) {
      case Some(req) -> {
        @logger.info(req.method + ' ' + req.path)
        @router.handle(req)
      }
      case None -> HttpResponse.json(400, '{"error":"malformed HTTP request"}')
    }
    let _ = client.write_string(response)
    let _ = client.flush
  }
}

class Cli {
  fn static usage -> String {
    let buf = StringBuffer.new
    buf.push(VERSION + '\n')
    buf.push('usage:\n')
    buf.push('  main serve [host] [port]        start the HTTP runtime and frontend host\n')
    buf.push('  main run "task"                 execute one autonomous session to completion\n')
    buf.push('  main resume                     resume every interrupted durable checkpoint\n')
    buf.push('  main skills                     print the active skill library\n')
    buf.push('  main metrics                    print runtime metrics\n')
    buf.push('  main playbook                   print the persistent knowledge playbook\n')
    buf.to_string
  }
}

class async Main {
  fn async main {
    let logger = Logger.with_file(LogLevel.Info, 'runtime.log')
    logger.info(VERSION + ' booting')
    Fs.ensure_dir(WORKSPACE_PATH)
    Fs.ensure_dir(TRACE_PATH)
    Fs.ensure_dir(WIKI_PATH)
    Fs.ensure_dir(SKILL_PATH)
    let args = env.arguments
    let runtime = AgentRuntime.new(logger)
    let command = if args.size > 0 { args.get(0) } else { 'serve' }
    if command == 'serve' {
      let host = if args.size > 1 { args.get(1) } else { DEFAULT_HOST }
      let port = if args.size > 2 { Int.parse(args.get(2), 10).or(DEFAULT_PORT) } else { DEFAULT_PORT }
      runtime.resume_all
      let router = Router.new(runtime, logger)
      let server = Server.new(router, logger, host, port)
      server.listen
    } else if command == 'run' {
      if args.size < 2 {
        let mut out = std.stdio.Stdout.new
        let _ = out.write_string(Cli.usage)
        return
      }
      let task = args.get(1)
      let criteria = Array.new
      let constraints = Array.new
      let sid = runtime.create_session('cli', task, criteria, constraints, MAX_STEPS_DEFAULT)
      let rec = runtime.run_session(sid)
      let mut out = std.stdio.Stdout.new
      let _ = out.write_string(rec.to_json + '\n')
    } else if command == 'resume' {
      runtime.resume_all
      let mut out = std.stdio.Stdout.new
      let _ = out.write_string('{"status":"resume_complete"}\n')
    } else if command == 'skills' {
      let mut out = std.stdio.Stdout.new
      let _ = out.write_string(runtime.skills_json + '\n')
    } else if command == 'metrics' {
      let mut out = std.stdio.Stdout.new
      let _ = out.write_string(runtime.metrics_json + '\n')
    } else if command == 'playbook' {
      let mut out = std.stdio.Stdout.new
      let _ = out.write_string(runtime.wiki.read_playbook + '\n')
    } else {
      let mut out = std.stdio.Stdout.new
      let _ = out.write_string(Cli.usage)
    }
  }
}
